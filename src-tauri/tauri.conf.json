{
  "$schema": "https://raw.githubusercontent.com/nicedoc/json-schemas/refs/heads/master/tauri/tauri-schema.json",
  "productName": "WuWa Mod Manager",
  "version": "0.2.0",
  "identifier": "com.wuwa.mod-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "targets": ["nsis"]
  },
  "app": {
    "windows": [
      {
        "title": "WuWa Mod Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"]
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/huyeon123/wuwa-mod-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFOTZDMzlDQzQ0QzBDOTgKUldTWURFekVuTU9XVG1kbUtrbnpaMjNTWXdzNzVnUVBrWHJUNk9obEVZZG1sTCt6dkw1K3FhNUUK"
    }
  }

}
